{
  "name": "destination-page-creator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "server": "node server.js",
    "dev-full": "concurrently -n 'VITE,SERVER' -c 'blue,magenta' \"npm run dev\" \"wait-on http://localhost:5173 && npm run server\"",
    "start": "npm run build && npm run server",
    "build-and-start": "npm run build && npm run server"
  },
  "dependencies": {
    "express": "^4.18.2",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/express": "^4.17.17",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^8.2.2",
    "npm-run-all2": "^9.0.3",
    "wait-on": "^7.0.1",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
